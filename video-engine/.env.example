# NVIDIA Build / NIM hosted video endpoint
# Create your key in NVIDIA Build and keep it secret. Never commit the real key.
NVIDIA_API_KEY=nvapi-REPLACE_ME
# Copy the current Cosmos3 Nano inference endpoint shown by NVIDIA Build.
NVIDIA_COSMOS_URL=REPLACE_WITH_CURRENT_NVIDIA_COSMOS_ENDPOINT
NVIDIA_COSMOS_MODEL=nvidia/cosmos3-nano

# ComfyUI fallback / future GPU worker
COMFYUI_URL=http://127.0.0.1:8188

# Shopify storefront/app origins, comma separated
CORS_ORIGINS=https://YOUR-SHOPIFY-DOMAIN.myshopify.com

# Optional future storage/CDN integration
VIDEO_OUTPUT_BASE_URL=
